{
  "name": "@local/dsh-plugin-task-notify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Task-completion and question toasts with a DingTalk-style notification sound",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.mp3"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-workspace": "*"
  },
  "scripts": {
    "build": "node scripts/embed-audio.mjs && tsdown",
    "watch": "tsdown --watch",
    "test": "node ../test-harness/browser-test.mjs"
  },
  "devDependencies": {
    "tsdown": "^0.23.2"
  }
}
