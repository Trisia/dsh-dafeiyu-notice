{
  "name": "@cliven/dsh-dafeiyu-notice",
  "version": "1.0.1",
  "type": "module",
  "description": "Task completion, question and approval reminders: a Dafeiyu big-fish notice with a DingTalk-style sound",
  "engines": {
    "dsh": ">=0.1.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "index.js",
    "dist/client.js",
    "dist/client.js.map",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.mp3"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-workspace": "*"
  },
  "scripts": {
    "build": "node scripts/embed-web-assets.mjs && tsc -p tsconfig.host.json && node scripts/embed-audio.mjs && tsdown",
    "typecheck": "node scripts/embed-web-assets.mjs && tsc --noEmit",
    "watch": "node scripts/embed-web-assets.mjs && tsdown --watch"
  },
  "devDependencies": {
    "tsdown": "^0.23.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trisia/dsh-dafeiyu-notice.git"
  },
  "homepage": "https://github.com/Trisia/dsh-dafeiyu-notice#readme",
  "bugs": {
    "url": "https://github.com/Trisia/dsh-dafeiyu-notice/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notification",
    "task-notify",
    "deepseek",
    "dafeiyu"
  ],
  "license": "MIT"
}
